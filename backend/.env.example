MONGO_URL=mongodb://localhost:27017
DB_NAME=integrated_patient_system

# Get a free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# JWT signing secret — generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
# Required in production. Defaults to a dev key if unset (not safe for real PHI).
SECRET_KEY=

# LLM backend: gemini (default) | azure | ollama
# ollama: brew install ollama && ollama pull llama3.2, then set LLM_BACKEND=ollama
# azure: set AZURE_OPENAI_ENDPOINT + AZURE_OPENAI_KEY + AZURE_OPENAI_DEPLOYMENT below
LLM_BACKEND=gemini
OLLAMA_MODEL=llama3.2

# Azure OpenAI (HIPAA-eligible path — requires signed BAA with Microsoft)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
